{
  "version": 1,
  "description": "请求参数校验黄金用例,Java 与 Go 共用,见 docs/design/1.4.0-validation-alignment.md。每个用例只有一个字段:按 field 构造校验项,用 request 里的请求(只用到与 field.in 对应的那一项)走一遍校验,结果必须等于 expect。只比较 ok、rule、code,不比较 message 和字段名(两种语言的字段名写法不同,见设计文档的已知差异)。",
  "format": {
    "field.in": "QUERY | HEADER | PATH | BODY",
    "field.name": "QUERY / HEADER / PATH 的参数名",
    "field.path": "BODY:相对请求体根的 JSON 路径,点号分隔,经过数组时对每个元素校验",
    "field.required": "是否必填",
    "field.rules": "校验规则,同规则 JSON 的 validate 项:type / pattern / code / message / level",
    "request.query": "原始查询串(不带 ?),空串表示没有查询参数",
    "request.headers": "请求头名 → 值;不在里面的头表示没带",
    "request.pathParams": "路径参数名 → 值",
    "request.body": "JSON 请求体(任意 JSON 值)",
    "expect": "{ok:true} 通过;{ok:false, rule, code} 失败。rule:NotNull / NotEmpty / Pattern / Required(只配必填没配规则时)"
  },
  "cases": [
    {
      "id": "query-optional-pattern-absent",
      "desc": "非必填、没传:不校验",
      "field": {
        "required": false,
        "rules": [
          {
            "type": "Pattern",
            "code": "1002",
            "level": 1,
            "message": "必须是数字",
            "pattern": "^[0-9]+$"
          }
        ],
        "in": "QUERY",
        "name": "p"
      },
      "request": {
        "query": ""
      },
      "expect": {
        "ok": true
      }
    },
    {
      "id": "query-optional-pattern-valid",
