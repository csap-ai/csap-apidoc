        {"name": "exact", "dataType": "String", "validate": [{"type": "Size", "pattern": "8"}]},
        {"name": "both", "dataType": "String", "validate": [{"type": "Length", "pattern": "7,"}, {"type": "Size", "pattern": "0,9"}]},
        {"name": "email", "dataType": "String", "validate": [{"type": "Size", "pattern": "0,10"}]},
        {"name": "withExample", "dataType": "String", "example": "keep-this-long-example", "validate": [{"type": "Size", "pattern": "0,4"}]}
      ]
    }
  ]
