<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ai.csap.apidoc.boot</groupId>
        <artifactId>csap-apidoc-boot</artifactId>
        <version>1.3.0</version>
    </parent>

    <artifactId>csap-apidoc-boot-starter</artifactId>
    <name>CSAP Apidoc Boot Starter</name>
    <description>Spring Boot starter for CSAP Apidoc: runtime API documentation, field rules and response filtering.</description>
    <dependencies>
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-yaml</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-sqlite</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-database</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-annotation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-devtools</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 运行时返回字段过滤,默认关闭(csap.apidoc.runtime.filter.enabled) -->
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 内嵌 MCP 端点 /csap/mcp,默认关闭(csap.apidoc.mcp.enabled) -->
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- test:数据库模式的端到端测试用 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
