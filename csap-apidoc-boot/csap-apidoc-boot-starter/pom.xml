<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ai.csap.apidoc.boot</groupId>
        <artifactId>csap-apidoc-boot</artifactId>
        <version>1.5.0</version>
    </parent>

    <artifactId>csap-apidoc-boot-starter</artifactId>
    <name>CSAP Apidoc Boot Starter</name>
    <description>Spring Boot starter for CSAP Apidoc: runtime API documentation, field rules and response filtering.</description>
    <dependencies>
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-yaml</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-sqlite</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-database</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-redis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-migrate</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-annotation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-devtools</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 运行时返回字段过滤,默认关闭(csap.apidoc.runtime.filter.enabled) -->
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 内嵌 MCP 端点 /csap/mcp,默认关闭(csap.apidoc.mcp.enabled) -->
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 内嵌 Mock 端点 /csap/mock/**,默认关闭(csap.apidoc.mock.enabled) -->
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-mock</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 向团队版注册服务,默认关闭(csap.apidoc.team.enabled) -->
        <dependency>
            <groupId>ai.csap.apidoc</groupId>
            <artifactId>csap-apidoc-team-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- test:Redis 模式的迁移端到端测试用 -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-redis</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <!-- test:数据库模式的端到端测试用(按规则重新生成文档需要 Web 环境) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
